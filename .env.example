# LLM API Configuration (required, supports OpenAI-compatible APIs)
LLM_API_KEY=your-api-key-here
LLM_API_URL=https://maas-api.ai-yuanjing.com/openapi/compatible-mode/v1
LLM_MODEL=glm-5

# TTS Configuration (optional)
TTS_ENGINE=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural

# MiniMax TTS Configuration (required when TTS_ENGINE=minimax)
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_API_URL=https://api.minimaxi.com/v1/t2a_v2
MINIMAX_VOICE_ID=Chinese (Mandarin)_Southern_Young_Man

# Optional: Whisper model size
WHISPER_MODEL=small

# Thumbnail Configuration (optional)
THUMBNAIL_FONT=/path/to/font.ttf
THUMBNAIL_DEFAULT_FONTS=ZCOOLGaoDuanHei-Regular.ttf,NotoSansSC-Bold.ttf,SourceHanSansSC-Bold.ttf
THUMBNAIL_FONT_SIZE_TITLE=72
THUMBNAIL_FONT_SIZE_SUBTITLE=14
THUMBNAIL_LOGO_PATH=images/logo.png
